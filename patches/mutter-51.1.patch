From 4ff3a7234da71c7af243ecacedd5db934356040e Mon Sep 17 00:00:00 2001
From: Rubin Simons <me@rubin55.org>
Date: Sun, 1 Nov 2026 14:46:42 +0100
Subject: [PATCH 20/24] onscreen/native: Ignored duplicate page flip events on
 tiled monitors

post_nonprimary_plane_update() added the page flip listener for each
CRTC of the tile group. Each flip event then completed the same frame.
The second event completed and unposted the next frame, which left two
buffers with a frame_info and one on scanout. ensure_back_bo() then
found no free buffer, and gnome-shell crashed in
meta_onscreen_native_get_buffer_age().

The page flip callbacks now ignore a frame that is no longer the
posted frame.
---
 src/backends/native/meta-onscreen-native.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/backends/native/meta-onscreen-native.c b/src/backends/native/meta-onscreen-native.c
index 5ee24e023a..de39360a71 100644
--- a/src/backends/native/meta-onscreen-native.c
+++ b/src/backends/native/meta-onscreen-native.c
@@ -445,6 +445,16 @@ notify_frame_info_complete (CoglFrameInfo *info)
   _cogl_onscreen_notify_complete (onscreen, info);
 }
 
+/* Tiled monitors send a flip event per CRTC; only one may complete */
+static gboolean
+is_posted_frame (ClutterFrame *frame)
+{
+  CoglFrameInfo *frame_info = clutter_frame_get_cogl_frame_info (frame);
+  CoglOnscreen *onscreen = cogl_frame_info_get_onscreen (frame_info);
+
+  return META_ONSCREEN_NATIVE (onscreen)->posted_frame == frame;
+}
+
 static void
 notify_crtc_presented (MetaKmsCrtc      *kms_crtc,
                        ClutterFrame     *frame,
@@ -509,6 +519,9 @@ page_flip_feedback_flipped (MetaKmsCrtc  *kms_crtc,
   int64_t presentation_time_us;
   CoglFrameInfoFlag flags = COGL_FRAME_INFO_FLAG_VSYNC;
 
+  if (!is_posted_frame (frame))
+    return;
+
   page_flip_time = (struct timeval) {
     .tv_sec = tv_sec,
     .tv_usec = tv_usec,
@@ -544,6 +557,9 @@ page_flip_feedback_ready (MetaKmsCrtc *kms_crtc,
   CoglFrameInfo *frame_info = clutter_frame_get_cogl_frame_info (frame);
   CoglOnscreen *onscreen = cogl_frame_info_get_onscreen (frame_info);
 
+  if (!is_posted_frame (frame))
+    return;
+
   frame_info->flags |= COGL_FRAME_INFO_FLAG_SYMBOLIC;
 
   notify_frame_info_complete (frame_info);
@@ -558,6 +574,9 @@ page_flip_feedback_mode_set_fallback (MetaKmsCrtc *kms_crtc,
   ClutterFrame *frame = user_data;
   int64_t now_us;
 
+  if (!is_posted_frame (frame))
+    return;
+
   /*
    * We ended up not page flipping, thus we don't have a presentation time to
    * use. Lets use the next best thing: the current time.
@@ -583,6 +602,9 @@ page_flip_feedback_discarded (MetaKmsCrtc  *kms_crtc,
   MetaOnscreenNative *onscreen_native = META_ONSCREEN_NATIVE (onscreen);
   int64_t frame_counter;
 
+  if (!is_posted_frame (frame))
+    return;
+
   /*
    * Page flipping failed, but we want to fail gracefully, so to avoid freezing
    * the frame clock, emit a symbolic flip.
