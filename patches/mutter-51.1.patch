From 9c93b6825577a544609f928b3ec4db46225b0aa4 Mon Sep 17 00:00:00 2001
From: Andrew de los Reyes <adlr@chromium.org>
Date: Sat, 3 Oct 2026 09:40:20 -0700
Subject: [PATCH 16/24] TILETEAR: tests: a tiled monitor's view spans all of
 its tiles

meta_check_monitor_configuration() compared each CRTC's layout against
the whole view layout. That holds while every view covers exactly one
CRTC, but a tiled monitor now has one view across all of its tiles, so
intersect the view layout with the CRTC's own rectangle first.
---
 src/tests/meta-monitor-test-utils.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/tests/meta-monitor-test-utils.c b/src/tests/meta-monitor-test-utils.c
index 20f87bf2a4..256cc4ccd1 100644
--- a/src/tests/meta-monitor-test-utils.c
+++ b/src/tests/meta-monitor-test-utils.c
@@ -636,6 +636,13 @@ meta_check_monitor_configuration (MetaContext           *context,
           g_assert_nonnull (view);
           clutter_stage_view_get_layout (CLUTTER_STAGE_VIEW (view),
                                          &view_layout);
+          if (expect->n_tiled_monitors > 0)
+            {
+              /* In a tiled setup, view_layout may include all tiles for the given monitor. */
+              MtkRectangle crtc_tile;
+              mtk_rectangle_from_graphene_rect (&crtc_config->layout, MTK_ROUNDING_STRATEGY_ROUND, &crtc_tile);
+              mtk_rectangle_intersect (&view_layout, &crtc_tile, &view_layout);
+            }
           g_assert_cmpfloat_with_epsilon (crtc_config->layout.origin.x,
                                           view_layout.x,
                                           FLT_EPSILON);
