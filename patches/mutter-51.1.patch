+      const MetaOutputInfo *output_info = meta_output_get_info (output);
+
+      if (output_info->tile_info.loc_h_tile == 0)
+        height += output_info->tile_info.tile_h;
+      if (output_info->tile_info.loc_v_tile == 0)
