From 0ab343a5127dc6f253abd83688fce07ce7c44ae2 Mon Sep 17 00:00:00 2001
From: Andrew de los Reyes <adlr@gmail.com>
Date: Sat, 18 Oct 2025 11:37:15 -0700
Subject: [PATCH 01/24] DEBUG: useful scripts for local building and testing

Needs this installed:

git clone https://github.com/ianlancetaylor/libbacktrace.git
./configure && make && sudo make install
---
 build.sh        | 3 +++
 install.sh      | 3 +++
 run-notile.sh   | 6 ++++++
 run-tile.sh     | 3 +++
 setup.sh        | 6 ++++++
 shell-notile.sh | 4 ++++
 shell-tile.sh   | 3 +++
 7 files changed, 28 insertions(+)
 create mode 100755 build.sh
 create mode 100755 install.sh
 create mode 100755 run-notile.sh
 create mode 100755 run-tile.sh
 create mode 100755 setup.sh
 create mode 100755 shell-notile.sh
 create mode 100755 shell-tile.sh

diff --git a/build.sh b/build.sh
new file mode 100755
index 0000000000..23bfe9032d
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,3 @@
+#!/bin/bash
+
+meson compile -C ${BUILDDIR:-builddir}
diff --git a/install.sh b/install.sh
new file mode 100755
index 0000000000..1096a84a37
--- /dev/null
+++ b/install.sh
@@ -0,0 +1,3 @@
+#!/bin/bash
+
+sudo meson install -C ${BUILDDIR:-builddir}
diff --git a/run-notile.sh b/run-notile.sh
new file mode 100755
index 0000000000..4953d59682
--- /dev/null
+++ b/run-notile.sh
@@ -0,0 +1,6 @@
+#!/bin/bash
+
+rm -f /var/run/user/1000/mutter-bt.log
+CLUTTER_DEBUG="frame-clock,frame-timings" MUTTER_DEBUG="backend,kms" dbus-run-session mutter --wayland vte-2.91 &> "${MUTTER_LOGFILE:-mutter-notile.log}"
+# Valgrind variant:
+#CLUTTER_DEBUG="frame-clock,frame-timings" MUTTER_DEBUG="backend,kms" dbus-run-session /usr/bin/valgrind --log-file=mutter-valgrind.txt --enable-debuginfod=no --leak-check=full --show-leak-kinds=definite mutter --wayland vte-2.91 &> "${MUTTER_LOGFILE:-mutter-notile.log}"
diff --git a/run-tile.sh b/run-tile.sh
new file mode 100755
index 0000000000..18a3dce99b
--- /dev/null
+++ b/run-tile.sh
@@ -0,0 +1,3 @@
+#!/bin/bash
+
+TILE_EN=1 MUTTER_LOGFILE="mutter-tile.log" ./run-notile.sh
diff --git a/setup.sh b/setup.sh
new file mode 100755
index 0000000000..7baeffe446
--- /dev/null
+++ b/setup.sh
@@ -0,0 +1,6 @@
+#!/bin/bash
+
+meson setup --buildtype=plain --prefix=/usr --libdir=/usr/lib64 --libexecdir=/usr/libexec --bindir=/usr/bin --sbindir=/usr/bin --includedir=/usr/include --datadir=/usr/share --mandir=/usr/share/man --infodir=/usr/share/info --localedir=/usr/share/locale --sysconfdir=/etc --localstatedir=/var --sharedstatedir=/var/lib --auto-features=enabled . ${BUILDDIR:-builddir} -Degl_device=true -Dtty_tests=true
+
+#meson setup ${BUILDDIR:-builddir}
+#meson configure ${BUILDDIR:-builddir} --prefix=/usr
diff --git a/shell-notile.sh b/shell-notile.sh
new file mode 100755
index 0000000000..e44c5dfa49
--- /dev/null
+++ b/shell-notile.sh
@@ -0,0 +1,4 @@
+#!/bin/bash
+
+rm -f /var/run/user/1000/mutter-bt.log
+CLUTTER_DEBUG="frame-clock,frame-timings" MUTTER_DEBUG="backend,kms" dbus-run-session gnome-shell --wayland -- vte-2.91 &> "${SHELL_LOGFILE:-shell-notile.log}"
diff --git a/shell-tile.sh b/shell-tile.sh
new file mode 100755
index 0000000000..8075166055
--- /dev/null
+++ b/shell-tile.sh
@@ -0,0 +1,3 @@
+#!/bin/bash
+
+TILE_EN=1 SHELL_LOGFILE="shell-tile.log" ./shell-notile.sh
-- 
2.56.0


